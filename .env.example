# NutriLens AI - Environment Configuration Example
# Copy this file or use dart-define when running the project.
#
# Execution:
#   flutter run -d chrome --dart-define=GEMINI_API_KEY="AIzaSy..."
#
# Release Build:
#   flutter build web --release --dart-define=GEMINI_API_KEY="AIzaSy..."

GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
