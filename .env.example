# NutriLens AI - Environment Configuration Example
# Copy this file or pass values via --dart-define when running or building the project.
#
# Recommended for Web / Production (routes AI requests through the Cloudflare Worker proxy
# so no API key is embedded in the compiled client bundle):
#   flutter run -d chrome --dart-define=GEMINI_PROXY_URL="https://your-worker.workers.dev"
#   flutter build web --release --dart-define=GEMINI_PROXY_URL="https://your-worker.workers.dev"
#
# Local Development Only (do NOT use GEMINI_API_KEY in public or Web release builds):
#   flutter run -d chrome --dart-define=GEMINI_API_KEY="AIzaSy..."

GEMINI_PROXY_URL="https://your-worker.workers.dev"
GEMINI_API_KEY="YOUR_LOCAL_GEMINI_API_KEY_HERE"
